<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="pigManureShed" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_storeItem_animalBarnPigMedium</name>
        <image>store/store_openPig.dds</image>
        <price>109000</price>
        <functions>
            <function>$l10n_function_animalPenPig</function>
            <function>$l10n_function_adjustableMeadow</function>
        </functions>
        <lifetime>1000</lifetime>
        <dailyUpkeep>0</dailyUpkeep>
        <rotation>0</rotation>
        <brand>RUDOLFHOERMANN</brand>
        <species>PLACEABLE</species>
        <category>animalpens</category>
        <brush>
            <type>husbandry</type>
            <category>animals</category>
            <tab>pigs</tab>
        </brush>
    </storeData>

    <base>
        <filename>i3d/openPigShed.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
        <boughtWithFarmland>false</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true">
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>

        <sounds>
            <place        template="medImp" />
            <placeLayered template="pigLayer" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="dirt"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01"/>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <triggerMarkers>
        <triggerMarker node="markerFood"         filename="$data/shared/assets/marker/markerIconFood.i3d" />
        <triggerMarker node="markerAnimals"      filename="$data/shared/assets/marker/markerIconAnimals.i3d" />
        <triggerMarker node="markerLiquidManure" filename="$data/shared/assets/marker/markerIconSlurry.i3d" />
        <triggerMarker node="markerWater" filename="$data/shared/assets/marker/markerIconWater.i3d" />
        <triggerMarker node="markerBales" filename="$data/shared/assets/marker/markerIconBale.i3d" />
        <triggerMarker node="markerLoad" filename="$data/shared/assets/marker/markerIconLoad.i3d" />
    </triggerMarkers>

    <hotspots>
        <hotspot type="PIG" teleportNode="teleportNode" />
    </hotspots>

    <animatedObjects>
        <animatedObject saveId="sideDoor" >
            <animation duration="3.0">
                <part node="sideDoor1">
                    <keyFrame time="0.0" translation="-2.407 1.2 7.325"/>
                    <keyFrame time="1.0" translation="-2.407 2.3 7.325"/>
                </part>
                <part node="sideDoor1Rotor">
                    <keyFrame time="0.0" rotation="0 0 0"/>
                    <keyFrame time="1.0" rotation="3600 0 0"/>
                </part>
                <part node="sideDoor1Rope">
                    <keyFrame time="0.0" scale="1 1 1"/>
                    <keyFrame time="1.0" scale="1 0.185 1"/>
                </part>
            </animation>
            <controls triggerNode="sideDoorsTrigger" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor" />
            <sounds>
                <moving linkNode="sideDoorsBase" template="plasitcVentilationGateLoop"/>
                <posEnd linkNode="sideDoorsBase" template="plasticDoorOpen" />
                <negEnd linkNode="sideDoorsBase" template="plasticDoorClose" />
            </sounds>
        </animatedObject>

        <animatedObject saveId="gateLarge" >
            <animation duration="1.5">
                <part node="gateMain">
                    <keyFrame time="0.0" rotation="0 0 0"/>
                    <keyFrame time="1.0" rotation="0 90 0"/>
                </part>
            </animation>
            <controls triggerNode="gateTrigger" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor" />
            <sounds>
                <moving linkNode="gateLargeDoor" template="fenceMetalLoop" fadeIn="0.2"/>
                <posEnd linkNode="gateLargeDoor" template="fenceMetalOpen" pitchScale="1"/>
                <negEnd linkNode="gateLargeDoor" template="fenceMetalClose" pitchScale="0.7"/>
            </sounds>
        </animatedObject>

        <animatedObject saveId="rollingDoor1" >
            <animation duration="5">
                <part node="rollingDoor1ColBottom">
                    <keyFrame time="0.0" translation="0 0 0"/>
                    <keyFrame time="1.0" translation="0 3.8 0"/>
                </part>
                <part node="rollingDoor1ColTop">
                    <keyFrame time="0.0" translation="0 0 0"/>
                    <keyFrame time="0.55" translation="0 0 0"/>
                    <keyFrame time="1.0" translation="0 1.7 0"/>
                </part>
                <part node="rollingDoor1">
                    <keyFrame time="0.0" translation="0 0 0" />
                    <keyFrame time="1.0" translation="0 3.85 0" />
                </part>
                <shader node="rollingDoor1" parameterName="visibilityCutThreshold">
                    <keyFrame time="0.0" values="0 - - -" />
                    <keyFrame time="1.0" values="0.94 - - -" />
                </shader>
            </animation>
            <controls triggerNode="rollingDoor1Trigger" posAction="ACTIVATE_HANDTOOL" posText="action_openGate" negText="action_closeGate" />
            <sounds>
                <moving linkNode="rollingDoor1Base" template="rollingGarageDoor" />
                <posEnd linkNode="rollingDoor1Base" template="slidingGateMetalOpen" />
                <negEnd linkNode="rollingDoor1Base" template="slidingGateMetalClose" />
            </sounds>
        </animatedObject>
    </animatedObjects>

    <dynamicallyLoadedParts>
        <dynamicallyLoadedPart node="0" linkNode="windowSwitch" filename="$data/shared/assets/lights/rudolfHormann/powerSwitch.i3d" />
    </dynamicallyLoadedParts>

    <infoTrigger triggerNode="infoTrigger" />

    <husbandry saveId="Animals_PIG" hasStatistics="false">
        <storage node="storage" fillTypes="LIQUIDMANURE STRAW WATER" isExtension="false">
            <capacity fillType="LIQUIDMANURE" capacity="100000" />
            <capacity fillType="STRAW"        capacity="30000" />
            <capacity fillType="WATER"        capacity="50000" />
        </storage>

         <unloadingStation supportsExtension="true" storageRadius="50" hideFromPricesMenu="true" >
            <unloadTrigger exactFillRootNode="exactFillRootNodeStraw" fillTypes="STRAW" />
            <baleTrigger triggerNode="baleTriggerStraw" fillTypes="STRAW"/>
            <unloadTrigger fillTypes="LIQUIDMANURE" />
            <unloadTrigger exactFillRootNode="exactFillRootNodeWater" fillTypes="WATER" />
         </unloadingStation>

         <loadingStation supportsExtension="true" storageRadius="50" fillTypes="STRAW">
            <loadTrigger triggerNode="liquidManureTrigger" fillTypes="LIQUIDMANURE" fillLitersPerSecond="2000" aiNode="aiLoadingNodeLiquidManure"/>
         </loadingStation>

        <animals type="PIG" baseMaxNumAnimals="100"  maxNumVisualAnimals="50">
            <navigation shape="navigationMeshShape"/>
            <loadingTrigger node="loadingTrigger" />
        </animals>

        <straw>
            <manure factor="1.5" />
            <strawPlane node="strawPlane" minY="-0.03" maxY="0.103" changeVisibility="true" />
        </straw>

        <food capacity="50000" >
            <foodPlaces>
                <foodPlace node="foodPlace1" />
                <foodPlace node="foodPlace2" />
            </foodPlaces>
            <foodPlane node="foodPlane" minY="0.020" maxY="0.19" changeVisibility="true" defaultFillType="WHEAT" />
            <unloadTrigger exactFillRootNode="exactFillRootNodeFood" />
        </food>

        <water automaticWaterSupply="false" >
            <waterPlane node="waterPlane" minY="0" maxY="1.075" changeVisibility="true" />
            <waterPlaces>
                <waterPlace node="waterPlace1" />
                <waterPlace node="waterPlace2" />
            </waterPlaces>
        </water>

        <fence xmlFilename="$data/placeables/brandless/fences/husbandries/level03/fencesFarmLevel03.xml">
            <sections>
                <section segmentId="SEGMENT" customizable="true">
                    <node node="fence1Node1" />
                    <node node="fence1Node2" />
                    <node node="fence1Node3" />
                    <node node="fence1Node4" />
                </section>
            </sections>
        </fence>

        <meadow>
            <createTask weedState="0">
                <fruit type="UNKNOWN" growthState="0"/>
                <ground type="NONE" />
                <terrainGroundType name="dirt" />
            </createTask>
        </meadow>
    </husbandry>

    <manureHeap node="manureHeap" capacity="2000000" isExtension="false" >
        <area startNode="tipAreaStart" widthNode="tipAreaWidth" heightNode="tipAreaHeight" activationTriggerNode="activationTrigger" />
        <clearArea startNode="clearAreaStart" widthNode="clearAreaWidth" heightNode="clearAreaHeight" />

        <loadingStation storageRadius="10" supportsExtension="false">
            <loadTrigger triggerNode="loadingTriggerManure" aiNode="loadingTriggerAINodeManure" fillTypes="MANURE" fillLitersPerSecond="2000" />
        </loadingStation>
    </manureHeap>

    <colorConfigurations>
        <material slotName="color_mat" />
        <colorConfiguration color="RUDOLFHOERMANN_GREEN"/>
        <colorConfiguration color="RUDOLFHOERMANN_BEIGE"/>
        <colorConfiguration color="RUDOLFHOERMANN_RED"/>
        <colorConfiguration color="RUDOLFHOERMANN_BLUE"/>
        <colorConfiguration color="RUDOLFHOERMANN_DARKGREY"/>
        <colorConfiguration color="RUDOLFHOERMANN_LIGHTGREY"/>
        <colorConfiguration color="RUDOLFHOERMANN_WHITEALU"/>
        <colorConfiguration color="RUDOLFHOERMANN_GREYALU"/>
        <colorConfiguration color="RUDOLFHOERMANN_OXIDRED"/>
        <colorConfiguration color="RUDOLFHOERMANN_WOODDARK"/>
        <colorConfiguration color="RUDOLFHOERMANN_WOODBRIGHT"/>
        <colorConfiguration color="RUDOLFHOERMANN_LIGHTGREEN"/>
        <colorConfiguration color="RUDOLFHOERMANN_DARKBEIGE"/>
    </colorConfigurations>

    <solarPanels>
        <solarPanelsConfigurations>
            <solarPanelsConfiguration name="$l10n_ui_no" isActive="false">
                <objectChange node="solarPanels" visibilityActive="false"/>
            </solarPanelsConfiguration>

            <solarPanelsConfiguration name="$l10n_ui_yes" isActive="true" price="20250" incomePerHour="70" />
        </solarPanelsConfigurations>
    </solarPanels>

    <i3dMappings>
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="levelAreaStart01" node="0>1|0" />
        <i3dMapping id="levelAreaWidth01" node="0>1|0|0" />
        <i3dMapping id="levelAreaHeight01" node="0>1|0|1" />
        <i3dMapping id="indoorAreaStart01" node="0>2|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>2|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>2|0|1" />
        <i3dMapping id="testAreaStart01" node="0>3|0" />
        <i3dMapping id="testAreaEnd01" node="0>3|0|0" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>4|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>4|0|0" />
        <i3dMapping id="sideDoorsBase" node="0>5|0" />
        <i3dMapping id="sideDoor1" node="0>5|0|0" />
        <i3dMapping id="sideDoor1Rotor" node="0>5|0|1" />
        <i3dMapping id="sideDoor1Rope" node="0>5|0|2" />
        <i3dMapping id="sideDoorsTrigger" node="0>5|0|3" />
        <i3dMapping id="windowSwitch" node="0>5|0|4"/>
        <i3dMapping id="gateMain" node="0>5|1|0"/>
        <i3dMapping id="gateTrigger" node="0>5|1|1"/>
        <i3dMapping id="gateLargeDoor" node="0>5|1"/>
        <i3dMapping id="rollingDoor1Base" node="0>5|2" />
        <i3dMapping id="rollingDoor1ColBottom" node="0>5|2|0" />
        <i3dMapping id="rollingDoor1ColTop" node="0>5|2|1" />
        <i3dMapping id="rollingDoor1" node="0>5|2|2" />
        <i3dMapping id="rollingDoor1Trigger" node="0>5|2|3" />
        <i3dMapping id="exactFillRootNodeFood" node="0>7|0" />
        <i3dMapping id="foodPlane" node="0>7|1" />
        <i3dMapping id="foodPlace1" node="0>7|2|0" />
        <i3dMapping id="foodPlace2" node="0>7|2|1" />
        <i3dMapping id="exactFillRootNodeStraw" node="0>8|0" />
        <i3dMapping id="baleTriggerStraw" node="0>8|1" />
        <i3dMapping id="strawPlane" node="0>8|2" />
        <i3dMapping id="exactFillRootNodeWater" node="0>9|0" />
        <i3dMapping id="waterPlane" node="0>9|1" />
        <i3dMapping id="waterPlace1" node="0>9|2" />
        <i3dMapping id="waterPlace2" node="0>9|3" />
        <i3dMapping id="liquidManureTrigger" node="0>10|0" />
        <i3dMapping id="aiLoadingNodeLiquidManure" node="0>10|1" />
        <i3dMapping id="manureHeap" node="0>11" />
        <i3dMapping id="activationTrigger" node="0>11|0" />
        <i3dMapping id="loadingTriggerManure" node="0>11|1" />
        <i3dMapping id="tipAreaStart" node="0>11|2|0" />
        <i3dMapping id="tipAreaWidth" node="0>11|2|1" />
        <i3dMapping id="tipAreaHeight" node="0>11|2|2" />
        <i3dMapping id="clearAreaStart" node="0>11|3|0" />
        <i3dMapping id="clearAreaWidth" node="0>11|3|1" />
        <i3dMapping id="clearAreaHeight" node="0>11|3|2" />
        <i3dMapping id="loadingTriggerAINodeManure" node="0>11|4" />
        <i3dMapping id="navigationRootNode" node="0>12" />
        <i3dMapping id="navigationMeshShape" node="0>12|0" />
        <i3dMapping id="fence1Node1" node="0>13|0|0" />
        <i3dMapping id="fence1Node2" node="0>13|0|0|0" />
        <i3dMapping id="fence1Node3" node="0>13|0|0|1" />
        <i3dMapping id="fence1Node4" node="0>13|0|0|2" />
        <i3dMapping id="teleportNode" node="0>14" />
        <i3dMapping id="storage" node="0>15" />
        <i3dMapping id="loadingTrigger" node="0>16" />
        <i3dMapping id="infoTrigger" node="0>17" />
        <i3dMapping id="solarPanels" node="0>18|1" />
        <i3dMapping id="markerLiquidManure" node="0>20|0" />
        <i3dMapping id="markerFood" node="0>20|5" />
        <i3dMapping id="markerAnimals" node="0>20|3" />
        <i3dMapping id="markerLoad" node="0>20|2" />
        <i3dMapping id="markerWater" node="0>20|4" />
        <i3dMapping id="markerBales" node="0>20|1" />

    </i3dMappings>
</placeable>
